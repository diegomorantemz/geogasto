# Copia este archivo como .env y completa tus credenciales.
# .env está en .gitignore: no lo subas al repositorio.

DB_URL=jdbc:postgresql://localhost:5432/GeoGasto
DB_USER=postgres
DB_PASSWORD=cambia_esta_password

# Clave para firmar los JWT (mínimo 256 bits). Genera una propia, por ejemplo:
# openssl rand -base64 48
JWT_SECRET=cambia_esta_clave_por_una_aleatoria_de_al_menos_256_bits
