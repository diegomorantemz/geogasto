# Copia este archivo como .env y completa tus credenciales.
# .env está en .gitignore: no lo subas al repositorio.

DB_URL=jdbc:postgresql://localhost:5432/GeoGasto
DB_USER=postgres
DB_PASSWORD=cambia_esta_password

# Clave para firmar los JWT (mínimo 256 bits). Genera una propia con:
#   openssl rand -base64 48
JWT_SECRET=cambia_esta_clave_por_una_aleatoria_de_al_menos_256_bits

# Opcionales
# JWT_EXPIRATION=86400000
# SEED_DEFAULT_CATEGORIES=true
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_MAX_REQUESTS=20
# RATE_LIMIT_WINDOW_SECONDS=60
# NOMINATIM_USER_AGENT=GeoGasto/1.0 (https://github.com/diegomorantemz/geogasto)
# APP_UPLOADS_DIR=uploads/receipts
# RECURRING_CRON=0 10 3 * * *
